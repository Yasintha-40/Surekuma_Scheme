PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=surekuma_db
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5173

# LRRS SQL Server. Read-only registry lookup, all years with IsTDL = 1.
# Enable after creating applicant_lrrs_registrations from surekuma_db.sql and configuring access.
LRRS_ENABLED=false
# sqlserver = live LRRS lookup; import = imported LRRS JSON in Surekuma MySQL.
LRRS_SOURCE=sqlserver
# Temporary LRRS bypass for existing active applicant accounts only; OTP remains required.
# Clear after testing. No registration number is fabricated.
LRRS_TEST_EMAILS=
LRRS_SERVER=10.50.0.97
LRRS_INSTANCE=SLTDA
LRRS_DATABASE=SLTDA_License
LRRS_USER=
LRRS_PASSWORD=
# Optional fixed TCP port; overrides instance discovery when set.
LRRS_PORT=
# These match the supplied PHP connection. Use TLS when supported by the server.
LRRS_ENCRYPT=false
LRRS_TRUST_SERVER_CERTIFICATE=true

# Gmail OTP delivery. Use a Google App Password, not your Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional sender override (defaults to SMTP_USER).
SMTP_FROM=

# Optional SMS delivery via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
